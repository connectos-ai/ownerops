NODE_ENV=development
OWNEROPS_PORT=3100
OWNEROPS_BASE_URL=http://localhost:3100

DATABASE_URL=postgres://ownerops:ownerops_dev_password@localhost:5432/ownerops

# Optional AI provider. Leave blank for deterministic local rules.
OWNEROPS_AI_PROVIDER=local
OWNEROPS_OPENAI_COMPATIBLE_BASE_URL=
OWNEROPS_OPENAI_COMPATIBLE_API_KEY=
OWNEROPS_OPENAI_COMPATIBLE_MODEL=

# Optional Slack enhanced mode.
OWNEROPS_SLACK_CLIENT_ID=
OWNEROPS_SLACK_CLIENT_SECRET=
OWNEROPS_SLACK_SIGNING_SECRET=
OWNEROPS_SLACK_BOT_TOKEN=

# Optional Gmail enhanced mode.
OWNEROPS_GMAIL_CLIENT_ID=
OWNEROPS_GMAIL_CLIENT_SECRET=
OWNEROPS_GMAIL_REFRESH_TOKEN=
OWNEROPS_GMAIL_ACCOUNT=

# Optional app secrets. Generate unique values for real deployments.
OWNEROPS_SESSION_SECRET=replace-with-a-long-random-value
OWNEROPS_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-value
